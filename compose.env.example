# Local-only values for Docker Compose. Copy this file to compose.env.aeroeyes before starting.
POSTGRES_DB=aeroeyes
POSTGRES_USER=aeroeyes
POSTGRES_PASSWORD=aeroeyes_local_only

# These addresses are consumed by the browser, so they point to host ports.
VITE_MONITORING_API_URL=http://localhost:18000
CORS_ALLOWED_ORIGINS=http://localhost:18080

AEROEYES_API_PORT=18000
AEROEYES_WEB_PORT=18080
